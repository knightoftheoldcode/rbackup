#!/bin/bash
# rbackup: the "home" resticprofile profile, plus a few checks of its own.
#
#   rbackup doctor          schedules, latest snapshot age, canary restore
#   rbackup restore-test    restore the canary file from the latest snapshot
#                           and compare it (run weekly after `check`)
#   rbackup rotate-logs     keep each log under 5 MB (run before each backup)
#   rbackup summary         last N scheduled runs per job, parsed from the
#                           schedule-log files (backup/check/forget)
#   rbackup status [--json] are backups healthy right now? local files only
#                           (no network), cheap enough for a status bar
#   rbackup <anything else> passed to resticprofile, e.g. `rbackup snapshots`,
#                           `rbackup backup`, `rbackup mount ~/mnt`
#   --color=auto|always|never (first argument, or RBACKUP_COLOR) colors
#                           rbackup's own output; auto means only on a
#                           terminal, and NO_COLOR or TERM=dumb turns it off
#
# Reads ~/.config/rbackup/ (written by rbackup-setup): profiles.toml,
# setup.env (install ID, log dir, canary path; not secret) and rbackup.env
# (secrets, read here only for the healthcheck URL).
set -euo pipefail

CONF="${RBACKUP_CONF:-$HOME/.config/rbackup}"
[[ -f $CONF/setup.env ]] || { echo "rbackup: no $CONF/setup.env; run setup-backup first" >&2; exit 1; }
# shellcheck source=/dev/null
. "$CONF/setup.env"   # RBACKUP_ID, RBACKUP_LOGS, RBACKUP_CANARY

# Colors for rbackup's own output (resticprofile's passes through untouched).
# Decided once per stream: stdout for reports, stderr for failures, so a
# schedule log (a file) never gets escape codes.
color_mode=${RBACKUP_COLOR:-auto}
if [[ ${1:-} == --color=* ]]; then color_mode=${1#--color=}; shift; fi
case $color_mode in
  auto | always | never) ;;
  *) echo "rbackup: --color must be auto, always or never (got $color_mode)" >&2; exit 2 ;;
esac
use_color() { # fd
  case $color_mode in
    always) return 0 ;;
    never) return 1 ;;
  esac
  [[ -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb && -t $1 ]]
}
C_OK="" C_BAD="" C_WARN="" C_BOLD="" C_DIM="" C_OFF=""
if use_color 1; then
  C_OK=$'\e[32m' C_BAD=$'\e[31m' C_WARN=$'\e[33m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_OFF=$'\e[0m'
fi
E_BAD="" E_OFF=""
if use_color 2; then E_BAD=$'\e[31m' E_OFF=$'\e[0m'; fi

# A status padded to the column width first, then colored, so the escape
# codes never count toward printf's field width and columns stay aligned.
status_cell() { # status width
  local cell color
  printf -v cell '%-*s' "$2" "$1"
  case $1 in
    ok) color=$C_OK ;;
    running) color=$C_WARN ;;
    error:* | interrupted | FAILED) color=$C_BAD ;;
    *) color="" ;;
  esac
  [[ -n $color ]] && cell="$color$cell$C_OFF"
  printf '%s' "$cell"
}

rp() { resticprofile --config "$CONF/profiles.toml" --name home "$@"; }

# restic itself, for read-only checks: no resticprofile lock and --no-lock on
# the repo, so restore-test can run inside the check job (which holds both)
# and doctor can run during a backup.
r() (
  while IFS='=' read -r k v; do
    [[ $k == RBACKUP_* || -z $k ]] || export "$k=$v"
  done <"$CONF/rbackup.env"
  export RESTIC_PASSWORD_FILE="$CONF/password"
  restic --no-lock "$@"
)

hc_url() { sed -n 's/^RBACKUP_HC_URL=//p' "$CONF/rbackup.env" 2>/dev/null || true; }

ping_fail() {
  local url
  url=$(hc_url)
  [[ -n $url ]] && curl -fsS -m 10 --retry 3 --data-raw "$1" "$url/fail" >/dev/null || true
}

# Seconds since the latest snapshot for this install, or empty if none.
snapshot_age() {
  local t
  t=$(r snapshots --host "$RBACKUP_ID" --latest 1 --json 2>/dev/null |
    jq -r 'if length == 0 then empty else .[-1].time end') || return 0
  [[ -n $t ]] || return 0
  # restic writes local time with an offset (2026-10-25T10:00:00.123-06:00).
  jq -rn --arg t "$t" '
    $t | capture("^(?<d>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:[0-9]{2})$")
    | (.d + "Z" | fromdateiso8601)
      - (if .z == "Z" then 0 else
           ((.z[1:3] | tonumber) * 3600 + (.z[4:6] | tonumber) * 60)
           * (if .z[0:1] == "+" then 1 else -1 end)
         end)
    | now - . | floor'
}

restore_test() {
  local got
  if ! got=$(r dump --host "$RBACKUP_ID" latest "$RBACKUP_CANARY" 2>/dev/null); then
    echo "rbackup: restore-test ${E_BAD}FAILED${E_OFF}: canary not in the latest snapshot ($RBACKUP_CANARY)" >&2
    ping_fail "restore-test failed on $RBACKUP_ID: canary missing"
    return 1
  fi
  if [[ $got != "$(cat "$RBACKUP_CANARY")" ]]; then
    echo "rbackup: restore-test ${E_BAD}FAILED${E_OFF}: restored canary differs from $RBACKUP_CANARY" >&2
    ping_fail "restore-test failed on $RBACKUP_ID: canary differs"
    return 1
  fi
  echo "rbackup: restore-test ${C_OK}ok${C_OFF} (canary restored from the latest snapshot)"
}

rotate_logs() {
  local f
  for f in "$RBACKUP_LOGS"/*.log; do
    [[ -f $f ]] || continue
    if (($(wc -c <"$f") > 5 * 1024 * 1024)); then mv -f "$f" "$f.1"; fi
  done
}

# YYYY/MM/DD HH:MM:SS (resticprofile's log timestamp) -> epoch seconds.
# Always exits 0 (prints nothing on failure) so callers under `set -e` don't
# need to guard every call.
to_epoch() {
  local iso=${1//\//-}
  date -j -f "%Y-%m-%d %H:%M:%S" "$iso" +%s 2>/dev/null || date -d "$iso" +%s 2>/dev/null || true
}

# Seconds -> compact "1d4h" / "3h12m" / "42m" / "9s".
fmt_dur() {
  local s=$1
  if ((s >= 86400)); then printf '%dd%dh' "$((s / 86400))" "$(((s % 86400) / 3600))"
  elif ((s >= 3600)); then printf '%dh%dm' "$((s / 3600))" "$(((s % 3600) / 60))"
  elif ((s >= 60)); then printf '%dm' "$((s / 60))"
  else printf '%ds' "$s"
  fi
}

# Epoch seconds -> ISO 8601 with the local offset; nothing for empty input.
to_iso() {
  [[ -n ${1:-} ]] || return 0
  date -d "@$1" +%Y-%m-%dT%H:%M:%S%:z 2>/dev/null || date -r "$1" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null || true
}

# A job's next scheduled run (ISO 8601), from the systemd timer. Nothing on
# macOS: launchd has no "next fire" query.
next_run() { # backup|forget|check
  [[ $(uname -s) == Darwin ]] && return 0
  local v e
  v=$(systemctl --user show "resticprofile-$1@profile-home.timer" -p NextElapseUSecRealtime --value 2>/dev/null) || return 0
  [[ -n $v && $v != n/a ]] || return 0
  e=$(date -d "$v" +%s 2>/dev/null) || return 0
  to_iso "$e"
}

# One parse_runs row as a JSON object (or null): times in ISO 8601, the
# duration in seconds, "-" as null, counts as numbers, plus the job's own
# fields.
run_json() { # job row
  local job=$1 row=$2 start end se ee="" dur=""
  [[ -n $row ]] || { echo null; return 0; }
  IFS=$'\t' read -r start end _ <<<"$row"
  se=$(to_epoch "$start")
  [[ $end != "-" ]] && ee=$(to_epoch "$end")
  [[ -n $se && -n $ee ]] && dur=$((ee - se))
  jq -cn --arg job "$job" --arg row "$row" --arg start "$(to_iso "$se")" \
    --arg end "$(to_iso "$ee")" --arg dur "$dur" '
    ($row | split("\t")) as $f
    | def v(i): if ($f[i] // "-") == "-" then null else $f[i] end;
      def n(i): v(i) | if . == null then null else (tonumber? // null) end;
      def s(x): if x == "" then null else x end;
    {start: s($start), end: s($end), status: v(2),
     duration_seconds: (s($dur) | if . == null then null else tonumber end),
     detail: v(12)}
    + if $job == "backup" then
        {files_new: n(4), files_changed: n(5), added: v(6), stored: v(7), snapshot: v(8)}
      elif $job == "forget" then
        {snapshots_removed: n(9), snapshots_kept: n(13), repository_size: v(10)}
      else
        {restore_test: v(11)}
      end'
}

# Parses one job's schedule-log into one tab-separated row per run (oldest
# first): start, end, status, restic's own duration (backup only), files new/changed, data
# added, snapshot id, snapshots removed, repo size remaining, restore-test
# result, a free-text detail (e.g. a lock contention), and snapshots kept
# (forget: the sum of its "keep N snapshots" lines). A run still open
# at EOF, or one a later "starting" line clobbers without a "finished"/ERROR
# in between, is reported as "interrupted".
parse_runs() { # job
  local log="$RBACKUP_LOGS/$1.log"
  # rotate_logs (run-before, every backup) renames $log to $log.1 past 5 MB
  # and starts a fresh $log; read both, oldest first, or history silently
  # stops at the last rotation.
  local logs=()
  [[ -f "$log.1" ]] && logs+=("$log.1")
  [[ -f "$log" ]] && logs+=("$log")
  ((${#logs[@]})) || return 0
  awk '
    # A run has two phases: "active" (between starting and finished/ERROR,
    # where the job body lines live) and, once finished, a trailing window
    # (still "have", not "active") where run-after output like the
    # restore-test line lands in the log before the next run starts.
    # Emission is deferred to the next "starting" line (or EOF) so that
    # trailing output has a chance to attach to the record it belongs to.
    function reset() {
      start = "-"; end = "-"; stat = "-"; procdur = "-"; fn = "-"; fc = "-"
      added = "-"; stored = "-"; snap = "-"; removed = "-"; remaining = "-"
      restore = "-"; detail = "-"; kept = 0; active = 0; have = 0
    }
    function emit() {
      print start "\t" end "\t" stat "\t" procdur "\t" fn "\t" fc "\t" \
        added "\t" stored "\t" snap "\t" removed "\t" remaining "\t" \
        restore "\t" detail "\t" (kept ? kept : "-")
    }
    BEGIN { reset() }
    $3 == "INFO" && $4 == "profile" && $6 == "starting" {
      if (have) { if (stat == "-") stat = "interrupted"; emit() }
      reset(); start = $1 " " $2; active = 1; have = 1; next
    }
    !have { next }
    active && $3 == "INFO" && $4 == "profile" && $6 == "finished" {
      stat = "ok"; end = $1 " " $2; active = 0; next
    }
    active && $3 == "ERROR" {
      stat = "error:" $NF; end = $1 " " $2; active = 0; next
    }
    active && /unable to create lock/ { detail = "locked" }
    active && $1 == "Files:" { fn = $2; fc = $4 }
    active && /^Added to the repository: / {
      line = $0
      sub(/^Added to the repository: /, "", line)
      split(line, parts, " \\(")
      added = parts[1]; stored = parts[2]
      sub(/ stored\)$/, "", stored)
    }
    active && /^processed / {
      line = $0
      sub(/^processed /, "", line)
      split(line, parts, " files, ")
      split(parts[2], parts2, " in ")
      procdur = parts2[2]
    }
    active && $1 == "snapshot" && $3 == "saved" { snap = $2 }
    active && /snapshots have been removed/ { removed = $1 }
    active && $1 == "keep" && $3 ~ /^snapshots?:?$/ { kept += $2 }
    active && $1 == "remaining:" {
      line = $0
      sub(/^remaining:[ ]*/, "", line)
      split(line, parts, "/")
      sz = parts[2]; sub(/^[ ]*/, "", sz)
      remaining = sz
    }
    active && $0 == "no errors were found" { if (detail == "-") detail = "clean" }
    /^rbackup: restore-test ok/ { restore = "ok" }
    /^rbackup: restore-test FAILED/ { restore = "FAILED" }
    END { if (have) { if (stat == "-") stat = "interrupted"; emit() } }
  ' "${logs[@]}"
}

# The last N runs of one job, newest first, as a table.
summary_job() {
  local job=$1 count=$2 rows n=0
  local log="$RBACKUP_LOGS/$job.log"
  echo "${C_BOLD}== $job ==${C_OFF} ${C_DIM}($log)${C_OFF}"
  if [[ ! -f $log && ! -f $log.1 ]]; then
    echo "  no log yet"
    return 0
  fi

  rows=$(parse_runs "$job" | tail -n "$count" | awk '{ a[NR] = $0 } END { for (i = NR; i > 0; i--) print a[i] }')

  if [[ -z $rows ]]; then
    echo "  no completed runs logged yet"
    return 0
  fi

  # The header and every row share one format string per job, so a column
  # can't drift out of alignment with its own label.
  # STATUS is %s, not %-12s: status_cell pads it before coloring.
  local common='  %-20s %s %-8s' fmt status_head
  status_head=$(status_cell STATUS 12)
  case $job in
    backup) fmt="$common"' %-5s %-5s %-13s %-13s %s' ;;
    forget) fmt="$common"' %-8s %-10s' ;;
    check) fmt="$common"' %-13s' ;;
  esac
  # shellcheck disable=SC2059 # $fmt is one of the three literals above, never data
  case $job in
    backup) printf "$fmt\n" START "$status_head" DURATION NEW CHG ADDED STORED SNAPSHOT ;;
    forget) printf "$fmt\n" START "$status_head" DURATION REMOVED REMAINING ;;
    check) printf "$fmt\n" START "$status_head" DURATION RESTORE-TEST ;;
  esac

  while IFS=$'\t' read -r start end stat procdur fn fc added stored snap removed remaining restore detail _kept; do
    n=$((n + 1))
    local dur="$procdur" note=""
    if [[ $end != "-" ]]; then
      local se ee
      se=$(to_epoch "$start")
      ee=$(to_epoch "$end")
      if [[ -n $se && -n $ee ]]; then
        local wall=$((ee - se))
        [[ $dur == "-" ]] && dur=$(fmt_dur "$wall")
        if [[ $procdur != "-" ]]; then
          # restic's own time (M:SS, or H:MM:SS past an hour) vs
          # resticprofile's wall clock: a big gap means the process stalled
          # (asleep, no network) in between.
          local psecs=0 part
          for part in ${procdur//:/ }; do psecs=$((psecs * 60 + 10#$part)); done
          ((wall > psecs + 3600)) &&
            note=" -- restic itself took $procdur; resticprofile didn't log 'finished' for $(fmt_dur "$wall")"
        fi
      fi
    fi
    [[ $dur == "-" ]] && dur="?"
    local cell
    cell=$(status_cell "$stat" 12)
    # shellcheck disable=SC2059 # $fmt is one of the three literals above, never data
    case $job in
      backup) printf "$fmt" "$start" "$cell" "$dur" "$fn" "$fc" "$added" "$stored" "$snap" ;;
      forget) printf "$fmt" "$start" "$cell" "$dur" "$removed" "$remaining" ;;
      check)
        # The last column: color it, padding is moot.
        local rt=$restore
        case $restore in ok) rt="$C_OK$restore$C_OFF" ;; FAILED) rt="$C_BAD$restore$C_OFF" ;; esac
        printf "$fmt" "$start" "$cell" "$dur" "$rt" ;;
    esac
    [[ $detail != "-" && $detail != "clean" ]] && printf ' %s(%s)%s' "$C_WARN" "$detail" "$C_OFF"
    [[ -n $note ]] && printf '%s%s%s' "$C_DIM" "$note" "$C_OFF"
    printf '\n'
  done <<<"$rows"
}

summary() {
  local count=5 jobs=() j
  while (($#)); do
    case "$1" in
      --count) count=$2; shift 2 ;;
      --count=*) count=${1#*=}; shift ;;
      backup | check | forget) jobs+=("$1"); shift ;;
      *) echo "rbackup summary: unknown argument: $1 (want backup/check/forget and/or --count N)" >&2; return 1 ;;
    esac
  done
  ((${#jobs[@]})) || jobs=(backup check forget)
  for j in "${jobs[@]}"; do
    summary_job "$j" "$count"
  done
}

# Is a scheduled job running right now? Asks the scheduler, so it's cheap
# and doesn't touch the repository.
job_running() { # backup|forget|check
  if [[ $(uname -s) == Darwin ]]; then
    launchctl print "gui/$(id -u)/local.resticprofile.home.$1" 2>/dev/null | grep -q "state = running"
  else
    systemctl --user is-active --quiet "resticprofile-$1@profile-home.service"
  fi
}

# One-line (or JSON) health for status bars and scripts, from local state
# only: the schedule logs and the scheduler. States, first match wins:
# running, none (nothing logged), failed (last backup errored or was cut
# short, or the last restore-test failed), stale (no good backup in 26h, the
# doctor and healthcheck window), ok. Exits 0 for ok and running, else 1.
status() {
  local json=0 a
  for a in "$@"; do
    case $a in
      --json) json=1 ;;
      *) echo "rbackup status: unknown argument: $a (want --json)" >&2; return 2 ;;
    esac
  done

  local running=() job
  for job in backup forget check; do
    job_running "$job" && running+=("$job")
  done

  local last good restore_row
  last=$(parse_runs backup | tail -n 1)
  good=$(parse_runs backup | awk -F'\t' '$3 == "ok"' | tail -n 1)
  restore_row=$(parse_runs check | awk -F'\t' '$12 != "-"' | tail -n 1)

  local last_stat="" good_at="" age="" restore="" restore_at=""
  [[ -n $last ]] && last_stat=$(cut -f3 <<<"$last")
  if [[ -n $good ]]; then
    good_at=$(cut -f2 <<<"$good")
    [[ $good_at == "-" ]] && good_at=$(cut -f1 <<<"$good")
    local ge
    ge=$(to_epoch "$good_at")
    [[ -n $ge ]] && age=$(($(date +%s) - ge))
  fi
  if [[ -n $restore_row ]]; then
    restore=$(cut -f12 <<<"$restore_row")
    restore_at=$(cut -f1 <<<"$restore_row")
  fi

  local state reason=""
  if ((${#running[@]})); then
    state=running; reason="${running[*]} running"
  elif [[ -z $last ]]; then
    state=none; reason="no scheduled backup logged yet"
  elif [[ $last_stat != ok ]]; then
    state=failed; reason="last backup: $last_stat"
  elif [[ $restore == FAILED ]]; then
    state=failed; reason="restore-test failed on $restore_at"
  elif [[ -z $age ]] || ((age > 26 * 3600)); then
    state=stale; reason="no successful backup in 26h"
  else
    state=ok; reason="healthy"
  fi

  local ago="never"
  [[ -n $age ]] && ago="$(fmt_dur "$age") ago"
  local text="$state: last backup $ago"
  [[ $state == ok ]] || text="$state ($reason), last backup $ago"
  local tooltip
  tooltip="rbackup $RBACKUP_ID
State: $state ($reason)
Last good backup: ${good_at:-none}${age:+ ($ago)}
Last restore test: ${restore:-none}${restore_at:+ ($restore_at)}
Running: ${running[*]:-nothing}"

  if ((json)); then
    local jobs_json="{}" repo=null j row forget_ok
    for j in backup forget check; do
      row=$(parse_runs "$j" | tail -n 1)
      jobs_json=$(jq -c --arg j "$j" --argjson last "$(run_json "$j" "$row")" \
        --arg next "$(next_run "$j")" \
        '. + {($j): {last_run: $last, next_run: (if $next == "" then null else $next end)}}' <<<"$jobs_json")
    done
    forget_ok=$(parse_runs forget | awk -F'\t' '$3 == "ok"' | tail -n 1)
    if [[ -n $forget_ok ]]; then
      repo=$(run_json forget "$forget_ok" | jq -c '{snapshots: .snapshots_kept, size: .repository_size, as_of: .end}')
    fi
    jq -cn --argjson jobs "$jobs_json" --argjson repository "$repo" --arg state "$state" --arg text "$text" --arg tooltip "$tooltip" \
      --arg reason "$reason" --arg last_good "$good_at" --arg age "${age:-}" \
      --arg restore "$restore" --arg restore_at "$restore_at" --arg install "$RBACKUP_ID" \
      --arg running "${running[*]:-}" '{
        state: $state, class: $state, text: $text, tooltip: $tooltip, reason: $reason,
        install: $install,
        last_backup: (if $last_good == "" then null else $last_good end),
        age_seconds: (if $age == "" then null else ($age | tonumber) end),
        restore_test: (if $restore == "" then null else $restore end),
        restore_test_at: (if $restore_at == "" then null else $restore_at end),
        running: ($running | split(" ") | map(select(. != ""))),
        schema: 2, jobs: $jobs, repository: $repository
      }'
  else
    local c=""
    case $state in ok) c=$C_OK ;; running) c=$C_WARN ;; *) c=$C_BAD ;; esac
    echo "${c}${text}${C_OFF}"
  fi
  [[ $state == ok || $state == running ]]
}

doctor() {
  local ok=0 age out
  echo "${C_BOLD}rbackup doctor: $RBACKUP_ID${C_OFF}"
  # status exits 0 even with nothing scheduled, so read what it says.
  out=$(rp status 2>&1) || ok=1
  printf '%s\n' "$out"
  grep -q "no scheduled jobs found" <<<"$out" && { echo "  ${C_BAD}schedules: none${C_OFF} (re-run setup-backup)"; ok=1; }
  # status passes when any one job is scheduled (a failed setup left only
  # check), so ask the scheduler for each job directly. On macOS a plist on
  # disk isn't enough either: after a restart launchd may not have loaded it.
  local job
  for job in backup forget check; do
    if [[ $(uname -s) == Darwin ]]; then
      launchctl print "gui/$(id -u)/local.resticprofile.home.$job" &>/dev/null ||
        { echo "  ${C_BAD}$job job: not loaded in launchd${C_OFF} (re-run setup-backup)"; ok=1; }
    else
      systemctl --user is-active --quiet "resticprofile-$job@profile-home.timer" ||
        { echo "  ${C_BAD}$job timer: not active${C_OFF} (re-run setup-backup)"; ok=1; }
    fi
  done
  age=$(snapshot_age)
  if [[ -z $age ]]; then
    echo "  ${C_BAD}latest snapshot: none${C_OFF}"; ok=1
  elif ((age > 26 * 3600)); then
    # Same window as the healthcheck (1 day + grace): laptops sleep overnight.
    echo "  ${C_BAD}latest snapshot: $((age / 3600))h ago${C_OFF} (more than 26h)"; ok=1
  else
    echo "  latest snapshot: ${C_OK}$((age / 60))m ago${C_OFF}"
  fi
  restore_test || ok=1
  if ((ok == 0)); then
    echo "${C_OK}rbackup doctor: all checks passed${C_OFF}"
  else
    echo "${C_BAD}rbackup doctor: problems found (see above)${C_OFF}"
  fi
  return $ok
}

case "${1:-}" in
  doctor) doctor ;;
  restore-test) restore_test ;;
  rotate-logs) rotate_logs ;;
  summary) shift; summary "$@" ;;
  status) shift; status "$@" ;;
  "") sed -n '2,10s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" ;;
  *) rp "$@" ;;
esac
